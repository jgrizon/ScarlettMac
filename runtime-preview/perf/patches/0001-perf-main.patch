+        for (offset, from, n) in spans {
+            // SAFETY: `pieces` holds the section, so its view stays mapped and
+            // the pages were committed above. `copy` keeps title memory that
+            // aliases this range readable as it was.
+            unsafe { std::ptr::copy(from as *const u8, dst.as_mut_ptr().add(offset), n) };
+        }
+        return true;
+    }
+    false
