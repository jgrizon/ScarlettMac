+/// Whether [`CountingAlloc`] names the call sites of its [`BIG`] blocks
+/// (`VICTORY_HEAP_SITES=1`, off by default): the first of each size class
+/// made, freed and resized since the last frame line, which names the vectors
+/// that grow past `BIG` again at every frame and pay for it in Wine's heap
+/// copies. A backtrace is not cheap, so only the first of a class is taken.
+fn heap_sites() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = std::env::var("VICTORY_HEAP_SITES").ok().as_deref() == Some("1");
+        if on {
+            tracing::info!(
+                "VICTORY_HEAP_SITES=1: the first big block made, freed and resized in each size class is named each report"
+            );
+        }
+        on
+    })
+}
+
+/// What a big block's site is named for: [`SITES`]' index per kind.
+const MADE: usize = 0;
+const FREED: usize = 1;
+const RESIZED: usize = 2;
+
+/// The size classes named since the last frame line, one mask per kind
+/// ([`MADE`], [`FREED`], [`RESIZED`]).
+static SITES: [Mutex<u64>; 3] = [const { Mutex::new(0) }; 3];
+
+/// Named big blocks since the last frame line, for its count.
+static SITES_NAMED: AtomicU64 = AtomicU64::new(0);
+
+/// Logs the stack of a [`BIG`] block of `size` bytes `kind` (one of
+/// [`MADE`], [`FREED`], [`RESIZED`]) that took from `started` until now, the
+/// first of its size class since the last frame line ([`heap_sites`]).
+fn note_site(kind: usize, size: usize, started: std::time::Instant) {
+    std::thread_local!(static INSIDE: std::cell::Cell<bool> = const { std::cell::Cell::new(false) });
+    if INSIDE.with(|i| i.replace(true)) {
+        return;
+    }
+    let class = 1u64 << size.ilog2().min(63);
+    let first = {
+        let mut seen = SITES[kind].lock().unwrap_or_else(|e| e.into_inner());
+        let first = *seen & class == 0;
+        *seen |= class;
+        first
+    };
+    if first {
+        let trace = std::backtrace::Backtrace::force_capture().to_string();
+        let frames: Vec<&str> = trace.lines().filter(|l| l.contains("victory")).take(24).collect();
+        SITES_NAMED.fetch_add(1, Relaxed);
+        tracing::info!(
+            kind = ["made", "freed", "resized"][kind],
+            mb = size >> 20,
+            us = started.elapsed().as_micros() as u64,
+            "a big heap block (first of its size class since the last line): {}",
+            frames.join(" | ")
+        );
+    }
+    INSIDE.with(|i| i.set(false));
+}
+
+/// Forgets the size classes named, at the frame line that reported them.
+fn clear_sites() -> u64 {
+    for seen in &SITES {
+        *seen.lock().unwrap_or_else(|e| e.into_inner()) = 0;
+    }
+    SITES_NAMED.swap(0, Relaxed)
+}
