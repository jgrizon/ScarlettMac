+    /// A texture's subresources detiled into one staging buffer on several
+    /// threads at once (the upload's workers, `VICTORY_TEXTURE_WORKERS`)
+    /// leave the bytes one thread leaves: each writes its own space of the
+    /// buffer, so the count and the split change nothing but the time.
+    #[test]
+    fn subresources_detiled_on_several_threads_match_one_thread() {
+        /// The subresources' own spaces of `staging`, as a staging buffer
+        /// lays them out: 512-aligned, front to back.
+        fn spaces<'a>(staging: &'a mut [u8], offsets: &[usize], ends: &[usize]) -> Vec<&'a mut [u8]> {
+            let (mut rest, mut from) = (&mut staging[..], 0usize);
+            let mut out = Vec::with_capacity(offsets.len());
+            for &at in offsets {
+                let (_, tail) = rest.split_at_mut(at - from);
+                let (mine, tail) = tail.split_at_mut(ends[out.len()] - at);
+                out.push(mine);
+                (rest, from) = (tail, ends[out.len() - 1]);
+            }
+            out
+        }
+
+        let cases = [
+            desc(1024, 1024, 12, 16, Swizzle::SW_4KB_S),
+            Desc {
+                block: 4,
+                ..desc(512, 512, 6, 4, Swizzle::SW_256B_D)
+            },
+            Desc {
+                depth: 5,
+                ..desc(640, 360, 4, 4, Swizzle::SW_64KB_D)
+            },
+            Desc {
+                dimension: Dimension::Tex3d,
+                depth: 32,
+                ..desc(256, 128, 5, 4, Swizzle::SW_4KB_S)
+            },
+        ];
+        for d in cases {
+            let layout = Layout::new(&d).unwrap();
+            let mips = d.mips;
+            let slices = if d.dimension == Dimension::Tex3d { 1 } else { d.depth };
+            let count = (mips * slices) as usize;
+            // As `GetCopyableFootprints` lays a texture out: a row pitch of
+            // its own for each subresource, its space 512-aligned.
+            let (mut offsets, mut ends, mut pitches, mut planes) =
+                (Vec::new(), Vec::new(), Vec::new(), Vec::new());
+            let mut at = 0usize;
+            for i in 0..count {
+                let m = layout.mips[(i as u32 % mips) as usize];
+                let pitch = (m.width as usize * d.element_bytes as usize).next_multiple_of(256);
+                let plane = pitch * m.height.max(1) as usize;
+                offsets.push(at);
+                pitches.push(pitch);
+                planes.push(plane);
+                at += (plane * m.depth.max(1) as usize).next_multiple_of(512);
+                ends.push(at);
+            }
+            let size = ends[count - 1];
+            // Tiled memory, every block of it different from its neighbours.
+            let tiled: Vec<u8> = (0..layout.size as usize)
+                .map(|i| ((i as u64).wrapping_mul(2_654_435_761) >> 24) as u8)
+                .collect();
+            let detile = |space: &mut [u8], i: usize| {
+                let (mip, slice) = (i as u32 % mips, i as u32 / mips);
+                layout
+                    .detile(&tiled, mip, slice, space, pitches[i], planes[i])
+                    .unwrap();
+            };
+            let mut serial = vec![0xccu8; size];
+            for (i, space) in spaces(&mut serial, &offsets, &ends).into_iter().enumerate() {
+                detile(space, i);
+            }
+            // The workers share the one detile: it holds nothing mutable.
+            let detile = &detile;
+            for threads in [2usize, 3, 8, count] {
+                let mut staging = vec![0xccu8; size];
+                let per = count.div_ceil(threads);
+                let mut spaces = spaces(&mut staging, &offsets, &ends);
+                std::thread::scope(|scope| {
+                    for (k, group) in spaces.chunks_mut(per).enumerate() {
+                        scope.spawn(move || {
+                            for (j, space) in group.iter_mut().enumerate() {
+                                detile(space, k * per + j);
+                            }
+                        });
+                    }
+                });
+                assert!(staging == serial, "{d:?} on {threads} threads");
+            }
+        }
+    }
