diff --git a/crates/victory-shader/src/emit/lower.rs b/crates/victory-shader/src/emit/lower.rs
index 87a266f..5249902 100644
--- a/crates/victory-shader/src/emit/lower.rs
+++ b/crates/victory-shader/src/emit/lower.rs
@@ -47,9 +47,21 @@ fn barrier_mode(writes_uavs: bool, lds_only: bool) -> u32 {
 }
 
 /// Whether `VICTORY_BARRIER_LDS=1` leaves barriers TGSM-only (diagnostic for
-/// the AGX `air.fence_` pipeline creation failure).
-fn barrier_lds_only() -> bool {
-    std::env::var("VICTORY_BARRIER_LDS").as_deref() == Ok("1")
+/// the AGX `air.fence_` pipeline creation failure). Part of the shader
+/// cache key ([`victory_gpu`'s] `shader_cache`), so toggling it does not
+/// reuse DXIL emitted with the other mode.
+pub fn barrier_lds() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("VICTORY_BARRIER_LDS").as_deref() == Ok("1"))
+}
+
+/// Whether `VICTORY_PS_SAMPLE_GRAD=1` lowers a pixel shader's implicit-LOD
+/// `sample` to `sampleGrad` with explicit coarse derivatives: D3DMetal on
+/// AGX M1 fails some mesh/PS pipelines with `air.sample_.v4f32`. Part of the
+/// shader cache key.
+pub fn ps_sample_grad() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("VICTORY_PS_SAMPLE_GRAD").as_deref() == Ok("1"))
 }
 
