+    at: usize,
+    len: usize,
+    write: &mut dyn FnMut(usize, &mut [u8]),
+) -> bool {
+    if len == 0 || !on_wine() {
+        return false;
+    }
+    let Some(end) = at.checked_add(len) else {
+        return false;
+    };
+    // A section's view is mapped the first time a copy needs it: that needs
+    // `PHYSICAL` unlocked, so a pass that finds one to map starts over.
+    for _ in 0..4 {
+        let pinned = pin(&physical_read(), at, end);
+        let (span, borrows) = match pinned {
+            Pinned::Ready(span, borrows) => (span, borrows),
+            Pinned::Map(sections) => {
+                if !sections.iter().all(|section| section.whole().is_some()) {
+                    return false;
+                }
+                continue;
+            }
+            Pinned::Hole | Pinned::Uncommitted | Pinned::Taken => return false,
+        };
+        for piece in &span {
+            let offset = piece.slice.index * PAGE + piece.offset;
+            let Some(whole) = piece.slice.section.existing_whole() else {
+                return false;
+            };
+            let from = (whole + offset) as *mut u8;
+            // SAFETY: the borrow holds the section, so its view stays mapped;
+            // these bytes are committed and no other holder borrows them.
+            let dst = unsafe { std::slice::from_raw_parts_mut(from, piece.len) };
+            write(piece.at - at, dst);
+        }
+        drop(borrows);
+        return true;
+    }
+    false
+}
