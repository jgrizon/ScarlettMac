+/// The blocks of every lane-branch region that touches LDS, when all of
+/// those regions only raise a flag ([`lds_flag_region`]): splitting one
+/// console wave across two host waves without a barrier in them changes
+/// nothing. `None` if a region does more than that.
+pub(super) fn lds_flag_blocks(x: &Parts) -> Option<HashSet<usize>> {
+    let regions = branch_regions(x.st)?;
+    let mut allowed = HashSet::new();
+    let mut any = false;
+    for (_, region) in regions {
+        let blocks: Vec<usize> = (0..region.len().min(x.p.blocks.len()))
+            .filter(|&b| {
+                region[b]
+                    && x.p.blocks[b].insts.iter().any(|i| {
+                        matches!(i.fields, Fields::Ds { .. })
+                            && !i.name().starts_with("ds_swizzle")
+                            && !i.name().contains("permute")
+                    })
+            })
+            .collect();
+        if blocks.is_empty() {
+            continue;
+        }
+        any = true;
+        if !lds_flag_region(x.p, x.st, &blocks) {
+            return None;
+        }
+        allowed.extend(blocks);
+    }
+    any.then_some(allowed)
+}
+
+/// Whether a lane-branch region (`blocks`, see [`branch_regions`]) that both
+/// reads and writes LDS only raises flags, so that it may run as two host
+/// waves without a barrier between them. The console runs such a region as
+/// one wave, where a lane's read sees every write before it; split in two, a
+/// read may miss the other half's write. That changes nothing the region
+/// leaves behind when:
+/// - every LDS access in it is a `ds_read_b32` or `ds_write_b32` at a constant
+///   address, and every write stores the same constant;
+/// - one address at most is both read and written in it (the flag), and every
+///   write a lane can reach after one of its reads goes to that flag;
+/// - it has no other effect (no store, atomic, export, message or barrier);
+/// - no value it computes is used after it.
+///
+/// A missed write only makes a lane go on as if the flag were still down;
+/// whatever that lane writes is the flag's own constant, which the write it
+/// missed has already put there. So the flag ends up raised exactly when some
+/// lane raises it, as on the console, and no other word or register depends
+/// on when it was seen.
+fn lds_flag_region(p: &Program, st: &Structured, blocks: &[usize]) -> bool {
+    let inside: HashSet<usize> = blocks.iter().copied().collect();
+    // where each value is written: (block, instruction)
+    let mut def: HashMap<Value, (usize, usize)> = HashMap::new();
+    for (b, block) in p.blocks.iter().enumerate() {
+        for (i, inst) in block.insts.iter().enumerate() {
+            for &(_, v) in &inst.writes {
+                def.insert(v, (b, i));
+            }
+        }
+    }
+    let inline = |op: &Operand| -> Option<u32> {
+        match *op {
+            Operand::Const(c @ 128..=192) => Some(u32::from(c) - 128),
+            Operand::Const(c @ 193..=208) => Some((-(i32::from(c) - 192)) as u32),
+            Operand::Literal(x) => Some(x),
+            _ => None,
+        }
+    };
+    // a VGPR value a `v_mov_b32` of a constant wrote, unguarded or under the
+    // same guard as `at`
+    let constant = |v: Option<Value>, at: (usize, usize)| -> Option<u32> {
+        let (b, i) = *def.get(&v?)?;
+        let inst = &p.blocks[b].insts[i];
+        if inst.name() != "v_mov_b32" {
+            return None;
+        }
+        let guard = st.guards.get(b).and_then(|g| g.get(i)).copied().flatten();
+        let same = guard.is_none() || (b == at.0 && guard == st.guards[at.0][at.1]);
+        let Fields::Valu(valu) = &inst.fields else {
+            return None;
+        };
+        if !same || valu.dpp.is_some() || valu.sdwa.is_some() {
+            return None;
+        }
+        inline(valu.src.first()?)
+    };
+    // every LDS access: (block, index, is_read, address)
+    let mut access: Vec<(usize, usize, bool, u32)> = Vec::new();
+    let mut stored: Option<u32> = None;
+    for &b in blocks {
+        for (i, inst) in p.blocks[b].insts.iter().enumerate() {
+            let name = inst.name();
+            if name.contains("store")
+                || name.contains("atomic")
+                || name.starts_with("exp")
+                || name.starts_with("s_sendmsg")
+                || name == "s_barrier"
+            {
+                return false;
+            }
+            let Fields::Ds {
+                addr,
+                data,
+                offset0,
+                offset1,
+                gds,
+                ..
+            } = &inst.fields
+            else {
+                if name.starts_with("ds_") {
+                    return false;
+                }
+                continue;
+            };
+            if name.starts_with("ds_swizzle") || name.contains("permute") {
+                continue;
+            }
+            let is_read = match name {
+                "ds_read_b32" => true,
+                "ds_write_b32" => false,
+                _ => return false,
+            };
+            if *gds {
+                return false;
+            }
+            let Some(Operand::Vector { reg, .. }) = *addr else {
+                return false;
+            };
+            let Some(base) = constant(inst.read(Reg::V(reg)), (b, i)) else {
+                return false;
+            };
+            let at = base.wrapping_add(u32::from(*offset0) | u32::from(*offset1) << 8);
+            if !is_read {
+                let Some(&Operand::Vector { reg, .. }) = data.first() else {
+                    return false;
+                };
+                let Some(k) = constant(inst.read(Reg::V(reg)), (b, i)) else {
+                    return false;
+                };
+                if stored.is_some_and(|s| s != k) {
+                    return false;
+                }
+                stored = Some(k);
+            }
+            access.push((b, i, is_read, at));
+        }
+    }
+    let read_at: HashSet<u32> = access.iter().filter(|a| a.2).map(|a| a.3).collect();
+    let written_at: HashSet<u32> = access.iter().filter(|a| !a.2).map(|a| a.3).collect();
+    let flags: Vec<u32> = read_at.intersection(&written_at).copied().collect();
+    if flags.len() > 1 {
+        return false;
+    }
+    if let Some(&flag) = flags.first() {
+        // the blocks of the region a lane can reach from `b` along one edge or more
+        let succ = |b: usize| -> Vec<usize> {
+            match st.exits[b] {
+                LaneExit::Jump(t) => vec![t],
+                LaneExit::Branch {
+                    taken, not_taken, ..
+                } => vec![taken, not_taken],
+                LaneExit::End | LaneExit::Indirect => Vec::new(),
+            }
+        };
+        for &(rb, ri, is_read, _) in &access {
+            if !is_read {
+                continue;
+            }
+            let mut seen: HashSet<usize> = HashSet::new();
+            let mut work: Vec<usize> = succ(rb)
+                .into_iter()
+                .filter(|t| inside.contains(t))
+                .collect();
+            while let Some(b) = work.pop() {
+                if seen.insert(b) {
+                    work.extend(succ(b).into_iter().filter(|t| inside.contains(t)));
+                }
+            }
+            let after = access.iter().any(|&(wb, wi, w_read, at)| {
+                !w_read && at != flag && ((wb == rb && wi > ri) || seen.contains(&wb))
+            });
+            if after {
+                return false;
+            }
+        }
+    }
+    // Nothing the region computes is used after it: no register it writes is
+    // live, lane by lane, where a lane leaves it. A lane's own write kills a
+    // register for that lane (an unguarded instruction that writes the whole
+    // dword); what an instruction reads of a VGPR only for the lanes outside
+    // EXEC (the old value of the one it writes) is no use.
+    let succ = |b: usize| -> Option<Vec<usize>> {
+        match st.exits[b] {
+            LaneExit::Jump(t) => Some(vec![t]),
+            LaneExit::Branch {
+                taken, not_taken, ..
+            } => Some(vec![taken, not_taken]),
+            LaneExit::End => Some(Vec::new()),
+            LaneExit::Indirect => None,
+        }
+    };
+    let n = st.exits.len().min(p.blocks.len());
+    if (0..n).any(|b| succ(b).is_none()) {
+        return false;
+    }
+    let exec = |r: Reg| matches!(r, Reg::S(c) if c == EXEC || c == EXEC + 1);
+    let covers = |ops: &[Operand], r: Reg| {
+        let Reg::V(x) = r else { return false };
+        ops.iter().any(|op| {
+            matches!(*op, Operand::Vector { reg, dwords }
+                if (u16::from(reg)..u16::from(reg) + u16::from(dwords.max(1))).contains(&u16::from(x)))
+        })
+    };
+    // per instruction: the registers it reads for its lanes, and those it
+    // writes in full
+    let effect = |b: usize, i: usize| -> (Vec<Reg>, Vec<Reg>) {
+        let inst = &p.blocks[b].insts[i];
+        let name = inst.name();
+        let partial = name.contains("16")
+            || name.contains("mac")
+            || name.contains("lane")
+            || matches!(&inst.fields, Fields::Valu(v) if v.dpp.is_some() || v.sdwa.is_some());
+        // the operands it reads explicitly, where its old destination is not
+        // one of them
+        let sources: Option<Vec<Operand>> = match &inst.fields {
+            Fields::Valu(v) if !partial => Some(v.src.clone()),
+            Fields::Ds { addr, data, .. } if !partial => {
+                Some(addr.iter().copied().chain(data.iter().copied()).collect())
+            }
+            Fields::Buffer { addr, data, .. }
+                if !partial && !name.contains("store") && !name.contains("atomic") =>
+            {
+                let _ = data;
+                Some(vec![*addr])
+            }
+            Fields::Image { addr, .. }
+                if !partial && !name.contains("store") && !name.contains("atomic") =>
+            {
+                Some(addr.clone())
+            }
+            _ => None,
+        };
+        let mut reads = Vec::new();
+        for &(r, _) in &inst.reads {
+            if exec(r) {
+                continue;
+            }
+            let old_only = matches!(r, Reg::V(_))
+                && inst.write(r).is_some()
+                && sources.as_ref().is_some_and(|src| !covers(src, r));
+            if !old_only {
+                reads.push(r);
+            }
+        }
+        let whole = st.guards.get(b).and_then(|g| g.get(i)).copied().flatten().is_none();
+        let kills: Vec<Reg> = if whole
+            && (sources.is_some()
+                || !matches!(
+                    inst.fields,
+                    Fields::Valu(_)
+                        | Fields::Ds { .. }
+                        | Fields::Buffer { .. }
+                        | Fields::Image { .. }
+                ))
+        {
+            inst.writes
+                .iter()
+                .map(|w| w.0)
+                .filter(|&r| !exec(r) && !(partial && matches!(r, Reg::V(_))))
+                .collect()
+        } else {
+            Vec::new()
+        };
+        (reads, kills)
+    };
+    let mut live_in: Vec<HashSet<Reg>> = vec![HashSet::new(); n];
+    loop {
+        let mut changed = false;
+        for b in (0..n).rev() {
+            let mut live: HashSet<Reg> = HashSet::new();
+            for t in succ(b).unwrap_or_default() {
+                if let Some(l) = live_in.get(t) {
+                    live.extend(l.iter().copied());
+                }
+            }
+            for i in (0..p.blocks[b].insts.len()).rev() {
+                let (reads, kills) = effect(b, i);
+                for r in kills {
+                    live.remove(&r);
+                }
+                live.extend(reads);
+            }
+            if live != live_in[b] {
+                live_in[b] = live;
+                changed = true;
+            }
+        }
+        if !changed {
+            break;
+        }
+    }
+    let written: HashSet<Reg> = blocks
+        .iter()
+        .flat_map(|&b| {
+            p.blocks[b]
+                .insts
+                .iter()
+                .flat_map(|i| i.writes.iter().map(|w| w.0))
+        })
+        .filter(|&r| !exec(r))
+        .collect();
+    let mut leaks: Vec<(usize, Reg)> = Vec::new();
+    for &b in blocks {
+        for t in succ(b).unwrap_or_default() {
+            if inside.contains(&t) {
+                continue;
+            }
+            for r in &live_in[t] {
+                if written.contains(r) {
+                    leaks.push((t, *r));
+                }
+            }
+        }
+    }
+    leaks.is_empty()
+}
+
 /// The thread id's x (`v0` on entry) of a wave64 compute program whose
 /// console waves are runs of 64 ids along x (a group 64-aligned along x,
 /// or one row): `id >> 6` and up is one value per console wave.
