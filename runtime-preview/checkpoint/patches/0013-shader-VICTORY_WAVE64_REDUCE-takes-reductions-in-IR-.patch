+#[test]
+fn uniform_control_follows_scalar_branches_but_not_lane_branches() {
+    let build = |words: &[u32]| {
+        let code: Vec<u8> = words.iter().flat_map(|w| w.to_le_bytes()).collect();
+        let p = ir::build(&code, false, 256).unwrap();
+        let st = structure::structure(&p).unwrap();
+        super::barriers::uniform_control(&p, &st)
+    };
+    // s_cmp_eq_u32 s1, 0; s_cbranch_scc1 past a move; s_mov_b32 s2, 1; s_endpgm
+    let scalar = build(&[
+        0xBF06_8001, 0xBF85_0001, 0xBE82_0381, S_ENDPGM,
+    ]);
+    assert!(scalar.iter().all(|&u| u), "{scalar:?}");
+    // v_cmpx_eq_u32 exec, 0, v0; s_cbranch_execz past a move; s_mov_b32 s2, 1; s_endpgm
+    let lane = build(&[
+        0x7DA4_0080, 0xBF88_0001, 0xBE82_0381, S_ENDPGM,
+    ]);
+    assert!(!lane[1] && !lane[2], "{lane:?}");
+}
