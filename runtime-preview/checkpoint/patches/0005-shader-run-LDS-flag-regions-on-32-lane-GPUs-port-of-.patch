+// ---- LDS flag regions (Belobug PR #4) ----
+
+/// `s[40:43]`: the raw UAV at table dword 16 (s0 is the table's address).
+const FLAG_PROLOGUE: [u32; 5] = [
+    0xBE84_0300, // s_mov_b32 s4, s0
+    0xBE85_0380, // s_mov_b32 s5, 0
+    0xF408_0A02,
+    0xFA00_0040, // s_load_dwordx4 s[40:43], s[4:5], 0x40
+    0xBF8C_C07F, // s_waitcnt lgkmcnt(0)
+];
+
+/// `buffer_store_dword v5, v16, s[40:43], 0 offen`.
+const FLAG_STORE_V5: [u32; 2] = [0xE070_1000, 0x800A_0510];
+
+/// `ds op vdst, addr, data0` at offset 0.
+const fn ds(op: u8, vdst: u8, addr: u8, data0: u8) -> [u32; 2] {
+    [
+        0x36 << 26 | (op as u32) << 18,
+        (vdst as u32) << 24 | (data0 as u32) << 8 | addr as u32,
+    ]
+}
+
+const DS_WRITE_B32: u8 = 0x0D;
+const DS_READ_B32: u8 = 0x36;
+
+/// One console wave of 64 threads with 512 bytes of LDS. The threads clear
+/// the flag, then the threads below s0 raise it and read it back inside
+/// their branch. Every thread stores the final flag plus one at its own UAV
+/// offset. `second` adds another write in the branch after the read.
+fn flag_program(second: Option<u32>) -> Vec<u32> {
+    let mut body = vec![
+        FLAG_PROLOGUE[0],
+        FLAG_PROLOGUE[1],
+        FLAG_PROLOGUE[2],
+        FLAG_PROLOGUE[3],
+        FLAG_PROLOGUE[4],
+        0x7E12_0280, // v_mov_b32 v9, 0
+    ];
+    body.extend(ds(DS_WRITE_B32, 0, 9, 9)); // ds_write_b32 v9, v9
+    let mut branch = vec![0x7E04_0281]; // v_mov_b32 v2, 1
+    branch.extend(ds(DS_WRITE_B32, 0, 9, 2)); // ds_write_b32 v9, v2
+    // (a scalar exit from the branch makes it blocks of their own, which only
+    // its lanes run)
+    let mut rest = ds(DS_READ_B32, 3, 9, 0).to_vec(); // ds_read_b32 v3, v9
+    if let Some(k) = second {
+        rest.push(0x7E0C_02FF); // v_mov_b32 v6, lit
+        rest.push(k);
+        rest.extend(ds(DS_WRITE_B32, 0, 9, 6)); // ds_write_b32 v9, v6
+    }
+    branch.extend_from_slice(&[
+        0xBF07_8001,                    // s_cmp_lg_u32 s1, 0
+        0xBF85_0000 | rest.len() as u32, // s_cbranch_scc1 past the rest
+    ]);
+    branch.extend_from_slice(&rest);
+    body.extend_from_slice(&[
+        0x7D88_0000,                      // v_cmp_gt_u32 vcc, s0, v0
+        0xBE8C_246A,                      // s_and_saveexec_b64 s[12:13], vcc
+        0xBF88_0000 | branch.len() as u32, // s_cbranch_execz past the branch
+    ]);
+    body.extend_from_slice(&branch);
+    body.push(0xBEFE_040C); // s_mov_b64 exec, s[12:13]
+    body.extend(ds(DS_READ_B32, 5, 9, 0)); // ds_read_b32 v5, v9
+    body.extend_from_slice(&[
+        0x4A0A_0A81, // v_add_nc_u32 v5, 1, v5
+        0x3420_0082, // v_lshlrev_b32 v16, 2, v0
+    ]);
+    body.extend(FLAG_STORE_V5);
+    body.push(S_ENDPGM);
+    body
+}
