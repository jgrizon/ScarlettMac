+
+    /// A wave64 program of 128 threads (two console waves) that leaves early
+    /// when no lane of its wave is below s0, as the console's compiler does
+    /// when the end of the program is too far for a branch:
+    /// `s_cbranch_execnz` over a far jump to the end. `extra` are words that
+    /// go into the far jump's block before it, and `work_at_end` puts an
+    /// instruction between the jump's target and the end of the program.
+    fn far_early_out(extra: &[u32], work_at_end: bool) -> Vec<u32> {
+        let gate = [
+            0x7D84_0001, // v_cmp_eq_u32 vcc, s1, v0
+            0xBE90_106A, // s_bcnt1_i32_b64 s16, vcc
+            0xBF06_8010, // s_cmp_eq_u32 s16, 0
+            0x8511_8281, // s_cselect_b32 s17, 1, 2
+            0x7E02_0211, // v_mov_b32 v1, s17
+            0x3404_0082, // v_lshlrev_b32 v2, 2, v0
+            0x38 << 26 | 0x1C << 18 | 1 << 12,
+            0x80 << 24 | 2 << 16 | 1 << 8 | 2, // buffer_store_dword v1, v2, s[8:11], 0 offen
+        ];
+        let jump = [
+            0xBE8E_1F00, // s_getpc_b64 s[14:15]
+            0x800E_FF0E,
+            4 * (4 + gate.len() as u32), // s_add_u32 s14, s14, the way to the end
+            0x820F_800F,                 // s_addc_u32 s15, s15, 0
+            0xBE80_200E,                 // s_setpc_b64 s[14:15]
+        ];
+        let mut words = vec![
+            0x7D88_0000, // v_cmp_gt_u32 vcc, s0, v0
+            0xBE8C_246A, // s_and_saveexec_b64 s[12:13], vcc
+            0xBF89_0000 | (extra.len() + jump.len()) as u32, // s_cbranch_execnz over the jump
+        ];
+        words.extend_from_slice(extra);
+        words.extend_from_slice(&jump);
+        words.extend_from_slice(&gate);
+        if work_at_end {
+            words.push(0x7E06_0281); // v_mov_b32 v3, 1
+        }
+        words.push(S_ENDPGM);
+        words
+    }
+
+    #[test]
+    fn a_far_early_out_is_left_out_and_one_that_does_work_is_not() {
+        let p = build_words(&far_early_out(&[], false), true);
+        assert_eq!(branches_named(&p, "s_cbranch_execnz"), 1);
+        let form = without_early_outs(&p).expect("the far early-out is left out");
+        assert_eq!(branches_named(&form, "s_cbranch_execnz"), 0);
+        for (name, words) in [
+            ("work in the jump", far_early_out(&[0xBE94_0385], false)), // s_mov_b32 s20, 5
+            ("work at the target", far_early_out(&[], true)),
+        ] {
+            let p = build_words(&words, true);
+            assert_eq!(branches_named(&p, "s_cbranch_execnz"), 1, "{name}");
+            assert!(without_early_outs(&p).is_none(), "{name}");
+            assert!(without_skips(&p, false).is_none(), "{name}");
+            assert!(without_skips(&p, true).is_none(), "{name}");
+        }
+    }
+
+    /// `if (t < s0) { park s[20:21]; if (s1 == 0) {..} else {..}; take it
+    /// back }` and a read of s[20:21] after the join, as the console's
+    /// compiler leaves a parked scalar across an inner branch. `then` is the
+    /// inner branch's first arm; the second one leaves the parked scalar
+    /// alone.
+    fn parked_across_an_inner_branch(then: u32) -> Program {
+        let body = [
+            0xBE96_0414, // s_mov_b64 s[22:23], s[20:21]
+            0xBF06_8001, // s_cmp_eq_u32 s1, 0
+            0xBF85_0002, // s_cbranch_scc1 to the second arm
+            then,
+            0xBF82_0001, // s_branch to the join
+            0xBE98_0382, // s_mov_b32 s24, 2
+            0xBE94_0416, // s_mov_b64 s[20:21], s[22:23]
+        ];
+        let mut words = vec![
+            0xBE94_0406, // s_mov_b64 s[20:21], s[6:7]
+            0x7D88_0000, // v_cmp_gt_u32 vcc, s0, v0
+            0xBE8C_246A, // s_and_saveexec_b64 s[12:13], vcc
+            0xBF88_0000 | body.len() as u32, // s_cbranch_execz past the body
+        ];
+        words.extend_from_slice(&body);
+        words.extend_from_slice(&[
+            0xBEFE_040C, // s_mov_b64 exec, s[12:13]
+            0x7E02_0214, // v_mov_b32 v1, s20
+            S_ENDPGM,
+        ]);
+        build_words(&words, false)
+    }
+
+    #[test]
+    fn a_skip_whose_parked_scalars_pass_an_inner_branch_unchanged_is_left_out() {
+        let p = parked_across_an_inner_branch(0xBE96_0314); // s_mov_b32 s22, s20
+        assert_eq!(branches_named(&p, "s_cbranch_execz"), 1);
+        // (s22 comes back through a phi of the inner join whose two arguments
+        // are copies of one value: only `deep` follows it)
+        assert!(without_skips(&p, false).is_none());
+        let deep = without_skips(&p, true).expect("left out");
+        assert_eq!(branches_named(&deep, "s_cbranch_execz"), 0);
+    }
+
+    #[test]
+    fn a_skip_whose_parked_scalar_an_inner_branch_changes_is_kept() {
+        let p = parked_across_an_inner_branch(0xBE96_0387); // s_mov_b32 s22, 7
+        assert_eq!(branches_named(&p, "s_cbranch_execz"), 1);
+        assert!(without_skips(&p, false).is_none());
+        assert!(without_skips(&p, true).is_none());
+    }
 }
