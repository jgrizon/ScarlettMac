+/// The barriers the title's enhanced groups carry that order a write, in the
+/// order they come; `None` for groups the host cannot read (a null pointer, a
+/// kind it does not know): those take the barrier that always came here.
+#[cfg(windows)]
+fn ordering(count: u32, groups: *const u8) -> Option<Vec<Named>> {
+    use windows::Win32::Graphics::Direct3D12::{
+        D3D12_BARRIER_ACCESS_UNORDERED_ACCESS, D3D12_BARRIER_GROUP, D3D12_BARRIER_TYPE_BUFFER,
+        D3D12_BARRIER_TYPE_GLOBAL, D3D12_BARRIER_TYPE_TEXTURE,
+    };
+    let mut named = Vec::new();
+    if groups.is_null() {
+        // Made up: the barrier that always came here.
+        return None;
+    }
+    // SAFETY: the title passes `count` groups of this layout, each naming as
+    // many barriers of its own kind as it counts.
+    unsafe {
+        let groups = groups.cast::<D3D12_BARRIER_GROUP>();
+        for group in std::slice::from_raw_parts(groups, count as usize) {
+            let n = group.NumBarriers as usize;
+            if n == 0 {
+                continue;
+            }
+            let kind = group.Type.0;
+            if kind == D3D12_BARRIER_TYPE_GLOBAL.0 {
+                let barriers = group.Anonymous.pGlobalBarriers;
+                if barriers.is_null() {
+                    return None;
+                }
+                for b in std::slice::from_raw_parts(barriers, n) {
+                    if orders(b) && written(b.AccessBefore) {
+                        named.push(Named {
+                            kind: GLOBAL_KIND,
+                            resource: std::ptr::null_mut(),
+                        });
+                    }
+                }
+            } else if kind == D3D12_BARRIER_TYPE_BUFFER.0 {
+                let barriers = group.Anonymous.pBufferBarriers;
+                if barriers.is_null() {
+                    return None;
+                }
+                for b in std::slice::from_raw_parts(barriers, n) {
+                    if orders(b) && written(b.AccessBefore) {
+                        named.push(Named {
+                            kind: BUFFER_KIND,
+                            resource: std::ptr::null_mut(),
+                        });
+                    }
+                }
+            } else if kind == D3D12_BARRIER_TYPE_TEXTURE.0 {
+                let barriers = group.Anonymous.pTextureBarriers;
+                if barriers.is_null() {
+                    return None;
+                }
+                for b in std::slice::from_raw_parts(barriers, n) {
+                    // The host moves each texture's copy to the state it needs
+                    // itself: only a shader write waits for this.
+                    let uav = b.AccessBefore.0 & D3D12_BARRIER_ACCESS_UNORDERED_ACCESS.0 != 0;
+                    if orders(b) && uav {
