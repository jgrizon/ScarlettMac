+#[test]
+fn a_branch_that_only_raises_an_lds_flag_runs_in_waves_of_32() {
+    // A read that misses the other host wave's write changes nothing the
+    // branch leaves behind, so the split wave needs no barrier there.
+    let l = lower_flag(&flag_program(None)).expect("lower");
+    assert_eq!(l.wave_size, None, "no WaveSize is needed for plain LDS");
+    // After the read the branch writes the flag again, with the same constant.
+    let l = lower_flag(&flag_program(Some(1))).expect("lower");
+    assert_eq!(l.wave_size, None);
+}
+
+#[test]
+fn a_branch_that_writes_lds_two_different_values_keeps_64_lanes() {
+    // A second value after the read: what the flag ends up holding depends on
+    // what was read, so the region is not a flag and halves refuse its LDS.
+    let err = match lower_flag(&flag_program(Some(2))) {
+        Ok(_) => panic!("a flag read and written with two values was taken"),
+        Err(e) => e.to_string(),
+    };
+    assert!(
+        err.contains("LDS one console wave64 shares without barriers"),
+        "{err}"
+    );
+}
