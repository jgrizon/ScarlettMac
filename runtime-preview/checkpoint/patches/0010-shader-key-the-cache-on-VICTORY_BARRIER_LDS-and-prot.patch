     })
 }
 
@@ -79,12 +86,23 @@ fn host_wave32() -> bool {
 /// This file, whose `encode` and `decode` define the entries.
 const ENCODING: &[u8] = include_bytes!("shader_cache.rs");
 
-fn key(translator: &str, encoding: &[u8], limit: u32, wave32: bool) -> [u8; 32] {
+fn key(
+    translator: &str,
+    encoding: &[u8],
+    limit: u32,
+    wave32: bool,
+    barrier_lds: bool,
+    ps_sample_grad: bool,
+) -> [u8; 32] {
     let mut h = blake3::Hasher::new();
     h.update(translator.as_bytes());
     h.update(blake3::hash(encoding).as_bytes());
     h.update(&limit.to_le_bytes());
     h.update(&[u8::from(wave32)]);
+    // Diagnostic emitter switches that change the DXIL (VICTORY_BARRIER_LDS,
+    // VICTORY_PS_SAMPLE_GRAD): a cached translation from the other setting
+    // must not be served.
+    h.update(&[u8::from(barrier_lds), u8::from(ps_sample_grad)]);
     *h.finalize().as_bytes()
 }
 
