+/// Whether `VICTORY_WAVE64_REDUCE=1` takes a wave reduction that sits in
+/// IR-uniform control flow (scalar branches only) even where [`in_step`]
+/// cannot prove the loop counts alike: the two halves reduce their own
+/// 32 lanes and exchange the result through threadgroup memory with a
+/// barrier. Part of the shader cache key.
+pub fn wave64_reduce() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("VICTORY_WAVE64_REDUCE").as_deref() == Ok("1"))
+}
