diff --git a/crates/victory-shader/src/emit/lower/barriers.rs b/crates/victory-shader/src/emit/lower/barriers.rs
index 42f7d70..a0b298f 100644
--- a/crates/victory-shader/src/emit/lower/barriers.rs
+++ b/crates/victory-shader/src/emit/lower/barriers.rs
@@ -279,6 +279,36 @@ pub(crate) fn uniform_control(p: &Program, st: &Structured) -> Vec<bool> {
     }
 }
 
+/// Per block, whether the wave-level control flow to it is the same for both
+/// host waves: every edge is a branch (lane or scalar) or a jump, no indirect
+/// exit. A branch on a lane condition does not split the waves (both execute
+/// both sides, masked); a scalar branch splits them only if the two waves
+/// compute different scalars, which this assumes they do not
+/// (`VICTORY_WAVE64_REDUCE`). For placing the halves' exchange barrier in a
+/// wave reduction, where [`uniform_control`] is stricter than needed.
+pub(crate) fn wave_path(p: &Program, st: &Structured) -> Vec<bool> {
+    let n = st.exits.len().min(p.blocks.len());
+    let edge = |b: usize| !matches!(st.exits[b], LaneExit::Indirect);
+    let mut same = vec![true; n];
+    loop {
+        let mut changed = false;
+        for b in 0..n {
+            let next = b == 0
+                || {
+                    let preds = &p.blocks[b].preds;
+                    !preds.is_empty() && preds.iter().all(|&q| q < n && same[q] && edge(q))
+                };
+            if same[b] != next {
+                same[b] = next;
+                changed = true;
+            }
+        }
+        if !changed {
+            return same;
+        }
+    }
+}
