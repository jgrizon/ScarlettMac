+/// 0xc0000005 in the title's own memcpy into an aliased page). Either way one
+/// `VirtualProtect` here sets both.
+fn write_access(at: usize, len: usize) {
+    let mut old = 0;
+    // SAFETY: the caller's mapping, which it owns; only its protection changes.
+    if unsafe { VirtualProtect(at as *const _, len, PAGE_READWRITE, &mut old) } != 0 {
+        return;
+    }
+    static ONCE: std::sync::Once = std::sync::Once::new();
+    ONCE.call_once(|| {
+        tracing::warn!(
+            at = format_args!("{at:#x}"),
+            len,
+            error = %std::io::Error::last_os_error(),
+            "the aliased pages would not take write access: writes there may fault"
+        );
+    });
+}
